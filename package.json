{
  "name": "atbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787",
    "test:login": "node scripts/test-login.mjs"
  },
  "dependencies": {
    "@zxing/browser": "0.1.5",
    "hono": "^4.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  }
}
