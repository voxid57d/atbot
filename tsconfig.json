{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["@cloudflare/workers-types", "vite/client", "node"]
  },
  "include": [
    "frontend",
    "backend",
    "shared",
    "tests",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
